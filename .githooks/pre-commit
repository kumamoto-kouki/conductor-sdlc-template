#!/usr/bin/env bash
# dashboard/status.json（および dashboard/status.init.json）の手編集ミスを、
# コミット前にスキーマ検証で水際チェックするpre-commitフック。
#
# なぜ必要か: v0.4.0 で dashboard/ のビルド生成物（*.html・_astro/・reports/・
# steering/）を Git 管理外にした（.gitignore 参照）ため、これまでこのフックが
# 担っていた「生成物の再ビルド漏れ防止（コミット整合）」という役目は消えた。
# 一方、status.json は唯一の真実として引き続き手編集する運用（.kiro/steering/
# operations.md 参照）であり、必須フィールド欠落や範囲外の値をコミットしてから
# npm run build 時に初めて気づく事故は防ぎたい。src/lib/schema.mjs の
# parseStatus（zod検証）をコミット前に直接呼び、失敗ならブロックする。
#
# 有効化: `git config core.hooksPath .githooks` が必要（scripts/init-project.sh の
# 初期化処理で自動設定される。既存リポジトリでは README.md の起動チェックリスト参照）。
#
# 挙動:
#   - ステージに dashboard/status.json・dashboard/status.init.json のいずれかが
#     含まれる場合のみ検証する。それ以外のコミットは何もしない（高速）。
#   - node_modules が無い場合は検証をスキップして警告する（ブロックしない）。
#     init-project.sh の初回コミット時点では npm install がまだで node_modules が
#     無いため、ここでブロックすると初回コミットが必ず失敗する回帰を再発させる。
#   - 検証対象はステージ内容（work treeでなく `git show :path` で読む）。
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

TARGET_FILES=()
while IFS= read -r f; do
  [ -n "$f" ] && TARGET_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -- dashboard/status.json dashboard/status.init.json)

if [ "${#TARGET_FILES[@]}" -eq 0 ]; then
  # status.json/status.init.json 以外の変更のみのコミット。何もしない。
  exit 0
fi

echo "pre-commit: dashboard/status(.init).json の変更を検知。スキーマ検証を実行します..."

if [ ! -d "$ROOT/node_modules" ]; then
  echo "" >&2
  echo "pre-commit: node_modules が見つからないため、スキーマ検証をスキップします。" >&2
  echo "npm install 後は次回コミットから検証が有効になります。" >&2
  exit 0
fi

status=0
for f in "${TARGET_FILES[@]}"; do
  if ! git show ":${f}" | node -e "
    import('./src/lib/schema.mjs').then(({ parseStatus }) => {
      let raw = '';
      process.stdin.setEncoding('utf8');
      process.stdin.on('data', (chunk) => { raw += chunk; });
      process.stdin.on('end', () => {
        try {
          parseStatus(JSON.parse(raw));
          console.log('  OK: ${f}');
        } catch (e) {
          console.error(e.message);
          process.exit(1);
        }
      });
    });
  " 2>&1; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: スキーマ検証に失敗しました。上記のエラーを解消してから" >&2
  echo "再度コミットしてください。" >&2
  echo "" >&2
  echo "どうしてもこのフックを迂回してコミットする場合（緊急時のみ・非推奨）:" >&2
  echo "  git commit --no-verify" >&2
  exit 1
fi

echo "pre-commit: スキーマ検証に合格しました。"
exit 0
