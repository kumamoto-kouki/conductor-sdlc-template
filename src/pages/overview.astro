---
// プロジェクト概要ページ（PO指示 v2 #1）。status-dashboard.astro の後半にあった
// 「📁 プロジェクト概要」パート（凡例・検証道具・体制図＝team-structure.mdx・
// external-services.mdx・pdca-practice.mdx・autonomy-tiers.mdx・用語集＝
// glossary.mdx）をそのまま移動したページ（削除ではなく移動＝情報量不変。
// 要素数・テキストの保存は完了報告の機械カウントで証明する）。
// Mermaid（体制図・外部サービス図）・用語集検索スクリプトもここへ一緒に移した。
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import BaseHead from "../components/BaseHead.astro";
import SectionNav from "../components/SectionNav.astro";
import MermaidRuntime from "../components/MermaidRuntime.astro";
import GlossarySearchScript from "../components/GlossarySearchScript.astro";

import TeamStructure from "../content/team-structure.mdx";
import ExternalServices from "../content/external-services.mdx";
import PdcaPractice from "../content/pdca-practice.mdx";
import AutonomyTiers from "../content/autonomy-tiers.mdx";
import Glossary from "../content/glossary.mdx";

// レフトナビ（PO指示 v2 #6・任意でoverview.htmlにも付ける）。
const sectionNavItems = [
  { href: "#legend", label: "色の意味（凡例）" },
  { href: "#test-tools", label: "テストを自動で回す道具" },
  { href: "#team-structure", label: "開発体制" },
  { href: "#external-services", label: "外部サービスとの関係" },
  { href: "#pdca", label: "進め方の実例（PDCA）" },
  { href: "#autonomy-tiers", label: "AIにどこまで任せるか" },
  { href: "#glossary", label: "用語集" },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="プロジェクト概要 ｜（プロジェクト名） 開発ダッシュボード" />
  </head>
  <body>
    <SiteHeader depth={0} active="overview" />
    <div class="page-with-nav">
      <SectionNav items={sectionNavItems} />
      <div class="wrap">
        <header class="hero">
          <h1 class="text-white">📁 プロジェクト概要</h1>
          <div class="mt-1.5 text-sm text-white/85">
            チーム・体制・進め方・用語。進捗そのものは <a class="text-white!" href="status-dashboard.html">ダッシュボード本体</a> を参照してください。
          </div>
        </header>

        <!-- ===== 凡例 ===== -->
        <h2 id="legend">色の意味（凡例）</h2>
        <div class="card">
          <div class="legend">
            <span><span class="badge badge-ok">緑</span> 完了・問題なし</span>
            <span><span class="badge badge-warn">黄</span> 途中・要注意</span>
            <span><span class="badge badge-bad">赤</span> 未着手・最優先</span>
            <span><span class="badge badge-mute">灰</span> これから</span>
            <span><span class="badge badge-upd">青</span> この版で更新した項目</span>
          </div>
        </div>

        <!-- ===== 検証の自動化 ===== -->
        <h2 id="test-tools">
          テストを自動で回す道具（3種そろいました）
          <span class="note">手で確認していた作業を機械にやらせる</span>
        </h2>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <div class="card">
            <h3>画面部品テスト <span class="badge badge-ok">導入・確認済</span></h3>
            <div class="tag">
              道具: happy-dom。ブラウザを起動せず画面部品の組み立てだけを高速に検査。キャラ編集画面の描画を自動チェック。
            </div>
          </div>
          <div class="card">
            <h3>出力の固定検査 <span class="badge badge-ok">導入・確認済</span></h3>
            <div class="tag">
              道具: insta。AI への指示文の組み立て結果を「お手本」と突き合わせ、意図しない変化を自動検出。
            </div>
          </div>
          <div class="card">
            <h3>
              実アプリ起動テスト
              <span class="badge badge-ok">導入・確認済</span>
              <span class="badge badge-upd">更新 6/28</span>
            </h3>
            <div class="tag">
              道具: tauri-driver ＋ WebdriverIO。本物のアプリを起動し、画面に主要パーツが出るかを確認。<code
                >pnpm e2e</code
              > → <strong>1件 合格</strong>（手順は <code>docs/e2e-setup.md</code>）。
            </div>
          </div>
        </div>

        <!-- ===== 開発体制（体制図） ===== -->
        <details class="fold" id="team-structure">
          <summary>
            開発体制（だれが作り・だれが確認するか）
            <span class="note">作る役とチェック役を必ず分ける</span>
          </summary>
          <div class="fold-body card">
            <TeamStructure />
          </div>
        </details>

        <!-- ===== 外部サービスとの関係 ===== -->
        <details class="fold" id="external-services">
          <summary>
            外部サービスとの関係（GitHub / Claude Design）
            <span class="note">どこで作り・どこへ出すか</span>
          </summary>
          <div class="fold-body card">
            <ExternalServices />
          </div>
        </details>

        <!-- ===== PDCA 実践 ===== -->
        <details class="fold" id="pdca">
          <summary>
            進め方の実例（計画→実行→確認→改善）
            <span class="note">＝PDCA。回した証拠を2件掲載</span>
          </summary>
          <div class="fold-body pdca">
            <PdcaPractice />
          </div>
        </details>

        <!-- ===== 自律ティア ===== -->
        <details class="fold" id="autonomy-tiers">
          <summary>
            AI にどこまで任せるか（3段階）<span class="note">段階を上げるほど自動、下げるほど人が関与</span>
          </summary>
          <div class="fold-body">
            <AutonomyTiers />
          </div>
        </details>

        <!-- ===== 用語集 ===== -->
        <details class="fold" id="glossary">
          <summary>
            用語集（固有名詞のかんたん解説）<span class="note">③ふだんの言葉で言い換え</span>
          </summary>
          <div class="fold-body">
            <Glossary />
            <GlossarySearchScript />
          </div>
        </details>

        <div class="foot">
          体制の正式版: <code>.kiro/steering/orchestration.md</code> ／ 詳しい記録:
          <code>.claude/reports/2026-06-27-product-state-and-handoff.md</code> ／ スタイルは Astro（ビルド時コンパイル）を利用。閲覧時のネット接続は不要です。 ／ 進捗そのものは <a href="status-dashboard.html">ダッシュボード本体</a> へ。
        </div>
      </div>
    </div>

    <!--
      Mermaid の読み込み・初期化・実行は src/components/MermaidRuntime.astro に
      抽出済み（ポータル化＝Wave3 #3 に伴い、ステアリング詳細ページ
      src/pages/steering/[slug].astro でも同じ ESM パターンを再利用するため）。
      スクリプトの中身自体は変更していない（詳しい設計意図は同コンポーネントの
      コメント参照）。
    -->
    <MermaidRuntime />
  </body>
</html>
