---
// ポータル化（Wave3 #3）: .claude/reports/<file>.md の詳細ページ。
// output: "static" + build.format: "file" のため、この動的ルートは
// dashboard/reports/<slug>.html として1ファイルずつ書き出される
// （astro.config.mjs のコメント・scripts/relativize-asset-paths.mjs 参照）。
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseHead from "../../components/BaseHead.astro";
import { titleFromEntry } from "../../lib/content.mjs";

export async function getStaticPaths() {
  const entries = await getCollection("reports");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const title = titleFromEntry(entry);
const { Content } = await render(entry);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`${title} ｜ 振り返り ｜（プロジェクト名） 開発ダッシュボード`} />
  </head>
  <body>
    <SiteHeader depth={1} active="reports" />
    <div class="wrap">
      <header class="hero">
        <h1 class="text-white">📝 {title}</h1>
        <div class="mt-1.5 text-sm text-white/85">
          <a class="text-white/85!" href="../reports.html">← 振り返り一覧へ戻る</a>
        </div>
      </header>

      <div class="card markdown-body">
        <Content />
      </div>

      <div class="foot">
        ダッシュボード本体へ戻る: <code>../status-dashboard.html</code>
      </div>
    </div>
  </body>
</html>
