---
// ポータル化（Wave3 #3）: .claude/reports/*.md の一覧ページ。
// content collections（glob loader・src/content.config.mjs 参照）で取り込み、
// 日付ファイル名の降順で並べる（README・_example も含め全件表示。
// 「情報を選別して落とさない」という要件のため）。
import { getCollection } from "astro:content";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeInitInline from "../components/ThemeInitInline.astro";
import { titleFromEntry, sortEntriesDesc } from "../lib/content.mjs";

const entriesRaw = await getCollection("reports");
const entries = sortEntriesDesc(entriesRaw).map((e) => ({
  slug: e.id.replace(/\.md$/, ""),
  title: titleFromEntry(e),
}));
---

<!doctype html>
<html lang="ja">
  <head>
    <ThemeInitInline />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>振り返り一覧 ｜（プロジェクト名） 開発ダッシュボード</title>
  </head>
  <body>
    <SiteHeader depth={0} active="reports" />
    <div class="wrap">
      <header class="hero">
        <h1 class="text-white">📝 振り返り（.claude/reports/）</h1>
        <div class="mt-1.5 text-[13px] text-white/85">
          実装後の軽量な振り返り記録。<code class="bg-white/15! text-white!">.claude/reports/*.md</code> を日付ファイル名の降順で一覧表示します。
        </div>
      </header>

      <h2>一覧<span class="note">{entries.length} 件</span></h2>
      <div class="card">
        <ul class="report-list">
          {
            entries.map((e) => (
              <li>
                <a href={`reports/${e.slug}.html`}>{e.title}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="foot">
        ダッシュボード本体へ戻る: <code>status-dashboard.html</code>
      </div>
    </div>
  </body>
</html>
