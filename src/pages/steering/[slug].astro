---
// ポータル化（Wave3 #3）: .kiro/steering/<file>.md の詳細ページ。
// operations.md・orchestration.md は ```mermaid コードフェンスを含むため、
// 本体ページ（status-dashboard.astro）と同じ ESM Mermaid ランタイムを読み込む
// （MermaidRuntime.astro 参照。図が無いページでも mermaid.run() が空振りする
// だけで無害なため、全ステアリング詳細ページで共通に読み込む）。
import { getCollection, render } from "astro:content";
import "../../styles/global.css";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseHead from "../../components/BaseHead.astro";
import MermaidRuntime from "../../components/MermaidRuntime.astro";
import { titleFromEntry } from "../../lib/content.mjs";

export async function getStaticPaths() {
  const entries = await getCollection("steering");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const title = titleFromEntry(entry);
const { Content } = await render(entry);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`${title} ｜ ステアリング ｜（プロジェクト名） 開発ダッシュボード`} />
  </head>
  <body>
    <SiteHeader depth={1} active="steering" />
    <div class="wrap">
      <header class="hero">
        <h1 class="text-white">🧭 {title}</h1>
        <div class="mt-1.5 text-sm text-white/85">
          <a class="text-white/85!" href="../steering.html">← ステアリング一覧へ戻る</a>
        </div>
      </header>

      <div class="card markdown-body">
        <Content />
      </div>

      <div class="foot">
        ダッシュボード本体へ戻る: <code>../status-dashboard.html</code>
      </div>
    </div>
    <MermaidRuntime />
  </body>
</html>
