---
// 節目(マイルストーン)カード。bar の幅・badge文言は milestone データから算出する
// （derive.mjs に計算を集約。ここでは表示のみ）。
import Badge from "./Badge.astro";
import { pct } from "../lib/derive.mjs";

interface Props {
  milestone: {
    title: string;
    progress: number;
    badge: { text: string; tone: string };
    evidence: string[];
    note?: string;
    remainingNote?: string;
  };
}

const { milestone } = Astro.props;
const notes = [milestone.note, milestone.remainingNote].filter(Boolean);
---

<div class="card">
  <h3>
    {milestone.title}
    <Badge badge={milestone.badge} evidence={milestone.evidence} />
  </h3>
  <div class="bar"><span style={`width: ${pct(milestone.progress)}%`}></span></div>
  {
    notes.length > 0 && (
      <div class="tag" set:html={notes.join("　残り: ")} />
    )
  }
</div>
