---
// 作業ボードの1カード（カンバンのカード）。size="sm"（待ち/進行中/レビュー中列）と
// size="md"（完了・受理列）でテキストサイズ・間隔が微妙に異なる（既存踏襲）。
//
// 更新箇所のピンポイント化（PO指示 v2 #7）: item.updatedAt があるカードだけに
// 小さな「更新」チップを表示する（カード全体を card-updated で塗る粗い粒度は撤去）。
import { laneColor, updatedChipLabel } from "../lib/derive.mjs";

interface Props {
  item: {
    id: string;
    lane: string;
    title: string;
    note?: string;
    actors?: string;
    actorsTip?: string;
    tip: string;
    specRef?: string;
    updatedAt?: string;
  };
  size: "sm" | "md";
}

const { item, size } = Astro.props;
const color = laneColor(item.lane);
// 最小フォント14px化（PO指示 v2 #4）に伴い、固定幅の丸バッジでは4文字ID
// （例: "K1-5"）が収まらないため、幅は min-w＋横paddingで文字数に追随させる。
const idBoxClass =
  size === "sm"
    ? "grid h-6 min-w-6 flex-none place-items-center rounded px-1 text-xs font-bold text-white"
    : "grid h-7 min-w-7 flex-none place-items-center rounded-md px-1 text-xs font-bold text-white";
const idBoxStyle = `background: ${color}`;
const titleClass =
  size === "sm"
    ? "min-w-0 flex-1 text-xs font-semibold"
    : "min-w-0 flex-1 text-sm font-semibold";
const gapClass = size === "sm" ? "gap-1.5" : "gap-2";
const trailingFontSize = size === "sm" ? "14px" : "15px";
// レーン（デザイン系／エンジニアリング系）を左ボーダーで明確に色分け
// （案A: 背景色の淡い差のみだった状態を強化）。
const cardStyle = `border-left: 3px solid ${color}`;
const updatedLabel = updatedChipLabel(item.updatedAt);
---

<div
  class={`board-card flex flex-wrap items-center ${gapClass} rounded-lg bg-card p-2 ring-1 ring-line`}
  style={cardStyle}
  title={item.tip}
  data-lane={item.lane}
  data-actors={item.actors || ""}
>
  <span class={idBoxClass} style={idBoxStyle}>{item.id}</span>
  <span class={titleClass}>{item.title}</span>
  {
    updatedLabel && (
      <span class="badge badge-upd" title={`この項目は ${item.updatedAt} に更新`}>
        {updatedLabel}
      </span>
    )
  }
  {
    item.specRef && (
      <a
        href={`#spec-${item.specRef}`}
        class="flex-none rounded bg-surface px-1.5 text-xs font-bold text-accent no-underline hover:underline"
        title="機能ごとの状態(spec)表の該当行へ"
      >
        仕様→
      </a>
    )
  }
  {
    item.note ? (
      <span class="flex-none rounded bg-surface px-1.5 text-xs font-bold text-muted">{item.note}</span>
    ) : item.actors ? (
      <span style={`font-size: ${trailingFontSize}`} title={item.actorsTip || ""}>{item.actors}</span>
    ) : null
  }
</div>
