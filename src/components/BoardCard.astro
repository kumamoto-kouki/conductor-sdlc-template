---
// 作業ボードの1カード（カンバンのカード）。size="sm"（待ち/進行中/レビュー中列）と
// size="md"（完了・受理列）でテキストサイズ・間隔が微妙に異なる（既存踏襲）。
import { laneColor } from "../lib/derive.mjs";

interface Props {
  item: {
    id: string;
    lane: string;
    title: string;
    note?: string;
    actors?: string;
    actorsTip?: string;
    tip: string;
  };
  size: "sm" | "md";
}

const { item, size } = Astro.props;
const color = laneColor(item.lane);
const idBoxClass =
  size === "sm"
    ? "grid h-5 w-6 flex-none place-items-center rounded text-[10px] font-bold text-white"
    : "grid h-6 w-7 flex-none place-items-center rounded-md text-[11px] font-bold text-white";
const idBoxStyle =
  size === "sm"
    ? `background: ${color}`
    : `background: ${color}; font-size: ${item.id.length > 3 ? "10" : "11"}px`;
const titleClass =
  size === "sm"
    ? "min-w-0 flex-1 text-[11px] font-semibold"
    : "min-w-0 flex-1 text-[11.5px] font-semibold";
const gapClass = size === "sm" ? "gap-1.5" : "gap-2";
const trailingFontSize = size === "sm" ? "10px" : "11px";
---

<div class={`flex items-center ${gapClass} rounded-lg bg-card p-1.5 ring-1 ring-line/60`} title={item.tip}>
  <span class={idBoxClass} style={idBoxStyle}>{item.id}</span>
  <span class={titleClass}>{item.title}</span>
  {
    item.note ? (
      <span class="flex-none rounded bg-[#f4efe7] px-1.5 text-[10px] font-bold text-muted">{item.note}</span>
    ) : item.actors ? (
      <span style={`font-size: ${trailingFontSize}`} title={item.actorsTip || ""}>{item.actors}</span>
    ) : null
  }
</div>
