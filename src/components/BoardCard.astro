---
// 作業ボードの1カード（カンバンのカード）。size="sm"（待ち/進行中/レビュー中列）と
// size="md"（完了・受理列）でテキストサイズ・間隔が微妙に異なる（既存踏襲）。
import { laneColor } from "../lib/derive.mjs";

interface Props {
  item: {
    id: string;
    lane: string;
    title: string;
    note?: string;
    actors?: string;
    actorsTip?: string;
    tip: string;
    specRef?: string;
  };
  size: "sm" | "md";
}

const { item, size } = Astro.props;
const color = laneColor(item.lane);
const idBoxClass =
  size === "sm"
    ? "grid h-5 w-6 flex-none place-items-center rounded text-[10px] font-bold text-white"
    : "grid h-6 w-7 flex-none place-items-center rounded-md text-[11px] font-bold text-white";
const idBoxStyle =
  size === "sm"
    ? `background: ${color}`
    : `background: ${color}; font-size: ${item.id.length > 3 ? "10" : "11"}px`;
const titleClass =
  size === "sm"
    ? "min-w-0 flex-1 text-[11px] font-semibold"
    : "min-w-0 flex-1 text-[11.5px] font-semibold";
const gapClass = size === "sm" ? "gap-1.5" : "gap-2";
const trailingFontSize = size === "sm" ? "10px" : "11px";
// レーン（デザイン系／エンジニアリング系）を左ボーダーで明確に色分け
// （案A: 背景色の淡い差のみだった状態を強化）。
const cardStyle = `border-left: 3px solid ${color}`;
// もとは ring-line/60。Tailwind v3 は var() ベースの色トークン（<alpha-value> 未定義）に
// 不透明度修飾子を付けるとユーティリティ自体を生成せず、preflight 既定の
// --tw-ring-color: rgb(59 130 246 / .5)（青・半透明）で実描画されていた。
// つまり受理済みの本番の見た目は「薄い青のリング」。Tailwind v4 は ring-line/60 を
// color-mix で本当に生成するため灰色に変わってしまう。見た目の維持を最優先し、
// 実際に描画されていた色を明示指定する（PersonaCard・BoardColumn・
// team-structure.mdx も同様）。意図的に灰色へ直す場合は ring-line に変えること。
const legacyRing = "ring-[rgb(59_130_246/0.5)]";
---

<div
  class={`board-card flex items-center ${gapClass} rounded-lg bg-card p-1.5 ring-1 ${legacyRing}`}
  style={cardStyle}
  title={item.tip}
  data-lane={item.lane}
  data-actors={item.actors || ""}
>
  <span class={idBoxClass} style={idBoxStyle}>{item.id}</span>
  <span class={titleClass}>{item.title}</span>
  {
    item.specRef && (
      <a
        href={`#spec-${item.specRef}`}
        class="flex-none rounded bg-surface px-1.5 text-[10px] font-bold text-accent no-underline hover:underline"
        title="機能ごとの状態(spec)表の該当行へ"
      >
        仕様→
      </a>
    )
  }
  {
    item.note ? (
      <span class="flex-none rounded bg-surface px-1.5 text-[10px] font-bold text-muted">{item.note}</span>
    ) : item.actors ? (
      <span style={`font-size: ${trailingFontSize}`} title={item.actorsTip || ""}>{item.actors}</span>
    ) : null
  }
</div>
