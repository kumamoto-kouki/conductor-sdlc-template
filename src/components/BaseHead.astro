---
// 全ページ共通の <head> 内容（PO指示 v2 #5・#6設計に伴う共通化）。
// これまで5ページ（status-dashboard・reports・reports/[slug]・steering・
// steering/[slug]）それぞれに ThemeInitInline・charset・viewport・title を
// 個別に書いていた重複を1箇所へ集約する（新規追加の overview.astro でも
// 同じ head を使うため、6ページ目の追加コストをゼロに保つ）。
//
// favicon: 外部ファイル・外部リクエストなしのインラインSVG data URI（絵文字📊）。
// <text> をSVGキャンバスいっぱいに描くだけの最小構成（フォント同梱等は不要、
// 絵文字はOS/ブラウザ側のフォントで描画される）。
import ThemeInitInline from "./ThemeInitInline.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

const FAVICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext x='50' y='58' font-size='58' text-anchor='middle' dominant-baseline='middle'%3E%F0%9F%93%8A%3C/text%3E%3C/svg%3E";
---

<ThemeInitInline />
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href={FAVICON} />
<title>{title}</title>
