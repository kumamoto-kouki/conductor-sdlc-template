---
// 用語集検索（Wave3 #4・vanilla JS）のスクリプト本体。
// glossary.mdx（MDX）の内部に直接 <script> を書くと、MDX コンパイラが
// スクリプト本文中の `{`/`}`（通常の JS 構文）を MDX 式構文として誤解釈し
// ビルドが壊れる（実際に "Unexpected end of file in expression" で確認済み）
// ため、.astro コンポーネントとして分離し status-dashboard.astro 側で
// <Glossary /> の直後に読み込む。
//
// dt＋dd 両方を case-insensitive に照合する。既定（入力が空）は全件表示
// （情報量不変の原則）。JSが動かない環境でも input 要素があるだけで
// dt/dd 自体は最初から全部見えている（非表示は絞り込み操作が起きてから
// 初めて発生する）。
---

<script is:inline>
  (function () {
    var input = document.getElementById("glossary-search");
    var countEl = document.getElementById("glossary-search-count");
    var grid = document.getElementById("glossary-grid");
    if (!input || !grid) return;
    var dts = grid.querySelectorAll("dl.glossary dt");

    function apply() {
      var q = input.value.trim().toLowerCase();
      var shown = 0;
      var total = dts.length;
      dts.forEach(function (dt) {
        var dd = dt.nextElementSibling;
        var text = (
          dt.textContent + " " + (dd ? dd.textContent : "")
        ).toLowerCase();
        var match = q === "" || text.indexOf(q) !== -1;
        dt.hidden = !match;
        if (dd) dd.hidden = !match;
        if (match) shown++;
      });
      countEl.textContent = q === "" ? "" : shown + " / " + total + " 件";
    }

    input.addEventListener("input", apply);
  })();
</script>
