---
// ダークモードトグル（Wave3 #4）: FOUC 防止の先行スクリプト。
// <head> の一番最初の子要素として置くこと（Astro は import した CSS の
// <link rel="stylesheet"> を <head> の末尾に自動追記するため、これより前に
// 置けば「CSS適用前に data-theme を確定させる」順序を保証できる。実際の
// 生成順序は dashboard/status-dashboard.html で確認済み）。
//
// localStorage に明示値（"light"|"dark"）が無い＝auto の場合は一切
// data-theme を設定しない。これにより「上書きなし状態はピクセル同一」
// （既存の @media (prefers-color-scheme: dark) だけが効く見た目）を保つ。
---

<script is:inline>
  (function () {
    try {
      var v = localStorage.getItem("dashboard-theme");
      if (v === "light" || v === "dark") {
        document.documentElement.setAttribute("data-theme", v);
      }
    } catch (e) {
      // localStorage が使えない環境（file:// の一部ブラウザ等）では何もしない
      // ＝auto と同じ既定の見た目にフォールバックする。
    }
  })();
</script>
