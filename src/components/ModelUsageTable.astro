---
// モデル選定の実績テーブル（規定でなく実績。.claude/playbooks/model-assignment.md 参照）。
// ヘッダーを含む完結したテーブルとして描画する（SpecsTable.astro の構造を踏襲）。
import { updatedChipLabel } from "../lib/derive.mjs";

interface Props {
  entries: Array<Record<string, any>>;
}

const { entries } = Astro.props;
---

<!-- 390px幅では5列が収まらない場合があるため、テーブル自身のコンテナ内だけで
     横スクロールさせる（ページ全体の横スクロールは禁止）。 -->
<div class="table-scroll">
  <table>
    <tr>
      <th>工程</th>
      <th>ロール</th>
      <th>モデル</th>
      <th>思考（effort）</th>
      <th>備考</th>
    </tr>
    {
      entries.map((e) => (
        <tr>
          <td>{e.phase}</td>
          <td>
            {e.role}
            {
              updatedChipLabel(e.updatedAt) && (
                <span class="badge badge-upd ml-1" title={`この記録は ${e.updatedAt} に更新`}>
                  {updatedChipLabel(e.updatedAt)}
                </span>
              )
            }
          </td>
          <td>
            <code>{e.model}</code>
          </td>
          <td>{e.effort ?? "—"}</td>
          <td>{e.note ?? "—"}</td>
        </tr>
      ))
    }
  </table>
</div>
