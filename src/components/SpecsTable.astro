---
// 機能ごとの状態(spec)テーブル。ヘッダーを含む完結したテーブルとして描画する。
import Badge from "./Badge.astro";
import { evidenceLabel, testsLabel } from "../lib/derive.mjs";

interface Props {
  specs: Array<Record<string, any>>;
}

const { specs } = Astro.props;
---

<!-- 390px幅では6列が収まらない場合があるため、テーブル自身のコンテナ内だけで
     横スクロールさせる（ページ全体の横スクロールは禁止）。 -->
<div class="table-scroll">
  <table>
    <tr>
      <th>機能（spec）</th>
      <th>仕様の段階</th>
      <th>実装</th>
      <th>テスト</th>
      <th>裏付け</th>
      <th>状態</th>
    </tr>
    {
      specs.map((s) => (
        // ボード→spec リンク（Wave3 #3）の着地点。id が無い spec は従来どおり
        // アンカー無しで描画される（後方互換）。
        <tr id={s.id ? `spec-${s.id}` : undefined}>
          <td>{s.name}</td>
          <td>{s.stage}</td>
          <td>{s.impl}</td>
          <td>{testsLabel(s)}</td>
          <td>{evidenceLabel(s.evidence)}</td>
          <td>
            <Badge badge={s.badge} evidence={s.evidence} />
          </td>
        </tr>
      ))
    }
  </table>
</div>
