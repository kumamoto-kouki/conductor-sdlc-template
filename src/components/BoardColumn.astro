---
// 作業ボードの1列（⏳待ち／🔨進行中／🔍レビュー中／✅完了・受理）。
import BoardCard from "./BoardCard.astro";

interface Props {
  title: string;
  style: string;
  items: Array<Record<string, any>>;
  size: "sm" | "md";
  footnote?: string;
}

const { title, style, items, size, footnote } = Astro.props;
---

<!-- もとは ring-line/70（実描画は v3 preflight 既定の薄い青リング。経緯は
     BoardCard.astro のコメント参照）。見た目維持のため実際の色を明示。 -->
<div class="overflow-hidden rounded-xl ring-1 ring-[rgb(59_130_246/0.5)]">
  <div class="px-3 py-1.5 text-xs font-bold" style={style}>{title}</div>
  {
    items.length ? (
      <div class="space-y-1.5 p-2">
        {items.map((item) => (
          <BoardCard item={item} size={size} />
        ))}
        {footnote && <div class="px-1 pt-0.5 text-[10px] text-muted">{footnote}</div>}
      </div>
    ) : (
      <div class="p-2 text-center text-[11px] text-muted">—</div>
    )
  }
</div>
