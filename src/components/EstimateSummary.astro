---
// 見積もり時間サマリー（KPI 4枚＋バー＋内訳表）。数値は derive.mjs の computeEstimate に集約
// （このコンポーネントでは再計算しない）。
import KpiStat from "./KpiStat.astro";
import { computeEstimate } from "../lib/derive.mjs";

interface Props {
  data: Record<string, any>;
}

const { data } = Astro.props;
const { rows, totalEstimate, totalDone, totalRemain, overallPct } =
  computeEstimate(data);
---

<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
  <KpiStat value={`~${totalEstimate}h`} label="全体の見積" tone="accent" variant="lg" />
  <KpiStat value={`~${totalDone.toFixed(1)}h`} label="これまで（換算）" tone="info" variant="lg" />
  <KpiStat value={`~${totalRemain.toFixed(1)}h`} label="残り（概算）" tone="warn" variant="lg" />
  <KpiStat value={`${overallPct}%`} label="全体の進捗" tone="ok" variant="lg" />
</div>
<div class="bar mt-3"><span style={`width: ${overallPct}%`}></span></div>
<details class="mt-3">
  <summary class="cursor-pointer text-xs font-semibold text-muted">
    内訳（マイルストーン別の見積・進捗・残り）
  </summary>
  <div class="table-scroll">
    <table class="mt-2">
      <tr>
        <th>区分</th><th>難易度</th><th>見積</th><th>進捗</th><th>これまで</th><th>残り</th>
      </tr>
      {
        rows.map((r) => (
          <tr>
            <td>{r.label}</td>
            <td>{r.difficulty}/5</td>
            <td>{r.estimateH}h</td>
            <td>{r.progressPct}%</td>
            <td>{r.done.toFixed(1)}h</td>
            <td>{r.remain.toFixed(1)}h</td>
          </tr>
        ))
      }
      <tr>
        <td><b>合計</b></td>
        <td>—</td>
        <td><b>{totalEstimate}h</b></td>
        <td><b>{overallPct}%</b></td>
        <td><b>{totalDone.toFixed(1)}h</b></td>
        <td><b>{totalRemain.toFixed(1)}h</b></td>
      </tr>
    </table>
  </div>
  <div class="mt-2 text-xs text-muted">
    計算式: 見積(h)=タスク数×難易度(1–5)×ボリューム係数 を丸めた概算。
    これまで=見積×進捗%、残り=見積×(1−進捗%)。
    全体の進捗% = Σ(見積×進捗) / Σ見積（上のKPI・この表・節目カードの bar はすべて同じ値から算出）。
    ※ AIエージェント実測とは別の「人間換算の参考値」です。
  </div>
</details>
